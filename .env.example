# ─────────────────────────── Bootstrap ───────────────────────────
# Это всё, что сервису нужно из окружения. Остальные настройки — AI-ключи и модели, триаж, хелпдеск,
# рабочие часы, бэкапы, часовой пояс, публичный адрес веб-панели — хранятся в базе и редактируются
# в веб-панели (⚙️ Настройки).

# Токен бота от @BotFather. Для личного триажа включите Business Mode: Bot Settings → Business Mode.
TELEGRAM_BOT_TOKEN=123456789:AAExampleExampleExampleExample
# Ваш Telegram user id (узнать: @userinfobot) — владелец: полный доступ к боту и веб-панели.
OWNER_ID=123456789

# Адрес, на котором слушает веб-панель (Telegram Mini App).
WEBAPP_ADDR=:8080
# Локальный SOCKS5-прокси без авторизации (например, инбаунд Xray), если Telegram или LLM-провайдеры
# заблокированы напрямую. Через него идут все исходящие запросы. Пусто — прямые соединения.
SOCKS5_PROXY=

# База SQLite; рядом, в каталоге backups/, лежат бэкапы.
DB_PATH=/var/lib/tg-triage/tgtriage.db
# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json

# Необязательно: свой Bot API сервер
# TELEGRAM_API_URL=https://api.telegram.org
# ⚠️ Только для локальной разработки: пускает в веб-панель без Telegram-подписи с приватных IP.
WEBAPP_DEV_INSECURE=false

# ─────────────────────────── Импорт старых настроек ───────────────────────────
# Переменные прежних версий (ANTHROPIC_API_KEY, GEMINI_API_KEY, GROQ_API_KEY, MISTRAL_API_KEY,
# OPENROUTER_API_KEY, AI_PROVIDER, *_MODEL, *_MODEL_PRESETS, *_MAX_TOKENS, *_BASE_URL, CLAUDE_EFFORT,
# CLAUDE_FALLBACKS, AI_TIMEOUT, AI_MAX_RETRIES, ANALYSIS_WORKERS, DEBOUNCE_SECONDS,
# DEBOUNCE_MAX_WAIT_SECONDS, SENSITIVITY, CONTEXT_MESSAGES, NOISE_PREFILTER_ENABLED, MARK_READ_ON_WORK,
# NOTIFY_DONE_ON_CLOSE, OWNER_ABOUT, DEEP_LINKS, DIGEST_ENABLED, DIGEST_TIME, TIMEZONE, WEBAPP_PUBLIC_URL,
# MESSAGE_RETENTION_DAYS, HELPDESK_ENABLED, HELPDESK_GROUP_ID, HELPDESK_ABOUT, BACKUP_*) по-прежнему
# читаются, но только один раз: при старте значение переносится в базу, если там этой настройки ещё нет.
# После первого запуска их можно удалить из .env — дальше источник правды — база.
