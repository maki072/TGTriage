# ─────────────────────────── Telegram ───────────────────────────
# Токен бота от @BotFather. В BotFather включите Business Mode: Bot Settings → Business Mode → Turn on.
TELEGRAM_BOT_TOKEN=123456789:AAExampleExampleExampleExample
# Ваш Telegram user id (узнать: @userinfobot). Только этот пользователь управляет ботом,
# и только его Business-подключение обрабатывается.
OWNER_ID=123456789
# Необязательно: свой Bot API сервер
TELEGRAM_API_URL=https://api.telegram.org
# Если сервер стоит там, где часть (или весь) нужный трафик заблокирован напрямую — укажите
# локальный SOCKS5-прокси без авторизации (например, инбаунд Xray/V2Ray). Через него пойдут ВСЕ
# исходящие запросы сервиса: Telegram Bot API, Claude, Gemini. Веб-панель (входящий HTTP) не
# затрагивается. Пусто — прямые соединения, как обычно.
SOCKS5_PROXY=
# Добавлять в карточки ссылку tg://openmessage на исходное сообщение (при отказе Telegram карточка уйдёт без ссылок)
DEEP_LINKS=true

# ─────────────────────────── AI-провайдеры ───────────────────────────
# Активный провайдер по умолчанию: claude | gemini | groq | mistral | openrouter (переключается в боте на лету).
# Нужен ключ хотя бы одного провайдера; провайдер без ключа в боте недоступен.
AI_PROVIDER=claude

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# Уровень effort для Claude: low | medium | high | xhigh | max (пусто — значение API по умолчанию).
# Для триажа коротких сообщений low даёт лучшее соотношение цена/скорость/качество.
CLAUDE_EFFORT=low
# Серверный fallback при отказе модели (применяется только к claude-opus-5 / claude-fable-5-1)
CLAUDE_FALLBACKS=true
CLAUDE_MAX_TOKENS=16000
CLAUDE_MODEL_PRESETS=claude-opus-5,claude-sonnet-5,claude-haiku-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_TOKENS=8192
GEMINI_MODEL_PRESETS=gemini-3.6-flash,gemini-3.8-flash,gemini-3.1-pro-preview
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Groq — бесплатный уровень без карты (console.groq.com), быстрый инференс на LPU,
# настоящий JSON Schema structured output. Лимиты и линейка бесплатных моделей часто меняются —
# проверяйте актуальный список на console.groq.com/docs/models.
# ⚠️ У console.groq.com жёсткая антифрод-защита Cloudflare: блокирует IP дата-центров/VPN
# (не геоблок). Если при регистрации видите "Access denied. Please check your network settings" —
# откройте сайт с мобильного интернета (не Wi-Fi/VPN); сами API-запросы к api.groq.com этим не
# ограничены, только веб-консоль для получения ключа.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=8192
GROQ_MODEL_PRESETS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3-32b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Mistral — бесплатный уровень без карты (console.mistral.ai), очень большая квота (~1 млрд
# токенов/месяц). ⚠️ Бесплатный тариф обязывает согласиться на использование ваших сообщений
# для обучения модели — обойти нельзя, взвесьте перед подключением (бот пересылает переписку).
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_MAX_TOKENS=8192
MISTRAL_MODEL_PRESETS=mistral-small-latest,mistral-large-latest,open-mistral-nemo
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# OpenRouter — агрегатор, ~20 бесплатных моделей одним ключом (openrouter.ai/keys), без карты.
# По умолчанию не хранит и не обучается на промптах (можно дополнительно исключить провайдеров,
# которые обучаются, в настройках приватности на сайте) — приватнее, чем Mistral. Лимит меньше
# (десятки запросов/день бесплатно), но для личного бота хватает.
# Модель по умолчанию — `openrouter/free`: спецслаг-автороутер, сам выбирает доступную бесплатную
# модель из пула (устойчив к тому, что конкретные ":free"-модели у них то пропадают, то временно
# лимитируются на общем пуле — 429 при пике спроса, наш код такое ретраит). Конкретную модель можно
# закрепить через пресеты — актуальный список с ценой 0 смотреть через GET /v1/models или на
# openrouter.ai/models (фильтр Free); суффикс ":free" — не гарантия бесплатности, проверяйте цену.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_MAX_TOKENS=8192
OPENROUTER_MODEL_PRESETS=openrouter/free,google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Таймаут одного запроса к LLM и число повторов (429/5xx/сетевые ошибки/невалидный JSON)
AI_TIMEOUT=90s
AI_MAX_RETRIES=3
# Параллельные анализы
ANALYSIS_WORKERS=2

# ─────────────────────────── Триаж ───────────────────────────
# Пауза тишины (сек) перед анализом пачки коротких сообщений
DEBOUNCE_SECONDS=20
# Жёсткий предел ожидания, если собеседник пишет непрерывно
DEBOUNCE_MAX_WAIT_SECONDS=120
# low | medium | high — чем выше, тем больше сообщений считается задачами
SENSITIVITY=medium
# Сколько предыдущих сообщений диалога передавать модели как контекст
CONTEXT_MESSAGES=12
# Пропускать вызов LLM для батчей, состоящих целиком из явного шума («спасибо», «ок», эмодзи-реакция —
# см. internal/service/noisefilter.go) — экономит токены/квоту на самом частом и наименее ценном трафике.
# Нарочно консервативно: одно сомнительное сообщение в батче — и весь батч всё равно уйдёт в LLM.
NOISE_PREFILTER_ENABLED=true
# Отмечать исходное сообщение прочитанным при «👀 В работу» (нужно право «Читать сообщения»)
MARK_READ_ON_WORK=true
# При «✅ Закрыть» предлагать отправить собеседнику «Готово!» (бот каждый раз спрашивает — не отправляет молча)
NOTIFY_DONE_ON_CLOSE=false
# Кто вы и чем занимаетесь — помогает модели отличать ваши задачи от шума
OWNER_ABOUT=Backend-разработчик и тимлид, отвечаю за платёжный сервис и админку.

# ─────────────────────────── Дайджест ───────────────────────────
DIGEST_ENABLED=true
DIGEST_TIME=09:00
TIMEZONE=Europe/Moscow

# ─────────────────────────── Веб-приложение (Telegram Mini App) ───────────────────────────
# Адрес, на котором слушает встроенный HTTP-сервер веб-панели (задачи, история, настройки)
WEBAPP_ADDR=:8080
# ⚠️ Только для локальной разработки: пускает запросы без Telegram-подписи (initData) с
# приватных/loopback-адресов — так веб-панель открывается прямо из браузера в вашей Wi-Fi сети,
# без публичного домена. Никогда не включайте на сервере, доступном из интернета.
WEBAPP_DEV_INSECURE=false
# Публичный https-адрес веб-панели (например, https://tg.example.com — свой домен с TLS перед сервисом).
# Пока пусто — кнопка «🌐 Открыть веб-панель» в боте не показывается. Заполните, когда домен будет готов.
WEBAPP_PUBLIC_URL=

# ─────────────────────────── Хранилище и логи ───────────────────────────
DB_PATH=/var/lib/tg-triage/tgtriage.db
# Хранить историю сообщений N дней (0 — бессрочно). Задачи не удаляются.
MESSAGE_RETENTION_DAYS=90
# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json
